{
  "name": "bowiesmith-github-io",
  "private": true,
  "description": "Bowie Smith's personal site: a list of artifacts, served as-is by GitHub Pages. Tool versions (node, pnpm, sbcl) are pinned in mise.toml.",
  "type": "module",
  "scripts": {
    "dev": "sirv . --dev --port 3000",
    "vendor": "node scripts/vendor.mjs",
    "mnist": "node scripts/fetch-mnist.mjs",
    "subset": "node scripts/make-subset.mjs && node scripts/bundle-data.mjs",
    "train": "sbcl --script lisp/train.lisp && node scripts/bundle-data.mjs",
    "bundle": "node scripts/bundle-data.mjs",
    "basement": "node scripts/basement-plan.mjs"
  },
  "dependencies": {
    "jscl": "0.9.0-alpha.0"
  },
  "devDependencies": {
    "sirv-cli": "3.0.1"
  }
}
